# Copy this file to .env and fill in real values.

# Random 32+ char secret used to sign offline tokens. NEVER rotate casually —
# rotating invalidates every cached token (clients just revalidate, no data loss).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=change-me-to-a-long-random-string

# Bearer token for GET /admin/licenses (protect the license list).
ADMIN_KEY=change-me-too

# Stripe webhook signing secret (whsec_...) from the webhook endpoint you create.
# Leave empty to disable /v1/webhooks/stripe (returns 503).
STRIPE_WEBHOOK_SECRET=

# Port to listen on.
PORT=8787

# Max devices per license key.
MAX_ACTIVATIONS_PER_KEY=3

# Offline token lifetime in days (clients revalidate after expiry).
TOKEN_TTL_DAYS=7

# SQLite database file location.
DB_FILE=./data/licenses.db
